<Page x:Class="WpfApp2.view.pages.pageImportExcel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:WpfApp2.viewmodel.importExcel"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Import Excel">

    <Page.DataContext>
        <vm:ImportExcelVm/>
    </Page.DataContext>

    <Border Background="#F5F5F5" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="NHẬP DỮ LIỆU TỪ EXCEL" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                <Separator Margin="0,5,0,0" Background="#DDD" Height="1"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Bước 1: Chọn tệp tin Excel (.xlsx)" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#555"/>
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="True" 
                                 Padding="8,5" 
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#CCC"
                                 FontSize="13"/>
                        <Button Grid.Column="1" 
                                Content="Select File" 
                                Width="100" Margin="10,0,0,0"
                                Command="{Binding BrowseFileCommand}"
                                Cursor="Hand"/>
                    </Grid>

                    <TextBlock Text="Bước 2: Chọn Sheet chứa dữ liệu" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#555"/>
                    <ComboBox ItemsSource="{Binding SheetList}" 
                              SelectedItem="{Binding SelectedSheet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Padding="8,5"
                              Width="300"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,30"/>

                    <Button Content="IMPORT" 
                            Command="{Binding InsertCommand}"
                            Height="45" Width="200"
                            HorizontalAlignment="Left"
                            Background="#2196F3" Foreground="White"
                            FontWeight="Bold" FontSize="14"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,20,0,0" Padding="10" CornerRadius="4" Background="#FFF3E0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#E65100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>