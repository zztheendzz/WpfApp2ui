<Page x:Class="WpfApp2.view.pages.pageUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:WpfApp2.viewmodel.tableVm"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="900">

    <Page.DataContext>
        <vm:UserViewModel/>
    </Page.DataContext>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="25,15" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.03"/>
            </Border.Effect>

            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="28" Height="28" 
                                             VerticalAlignment="Center" Foreground="#3B82F6"/>
                    <TextBlock Text="{DynamicResource m_UserTitle}" FontSize="20" FontWeight="Bold" 
                               Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#1E293B"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Width="250" 
                             materialDesign:HintAssist.Hint="{DynamicResource m_UserSearchHint}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" Padding="10,6" FontSize="13"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             BorderBrush="#CBD5E1"/>

                    <Button Content="{DynamicResource m_AddUser}" 
                            Command="{Binding AddCommand}"
                            Margin="15,0,0,0" 
                            Height="42"
                            Background="#3B82F6" 
                            BorderBrush="#3B82F6"
                            Foreground="White"
                            FontWeight="SemiBold"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.2" Color="#3B82F6"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <materialDesign:Card Grid.Row="1" Margin="20" VerticalAlignment="Stretch" 
                             
                             UniformCornerRadius="12" BorderThickness="1" BorderBrush="#E2E8F0">
            <DataGrid ItemsSource="{Binding Users}" 
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      Background="White"
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#F1F5F9"
                      HeadersVisibility="Column"
                      SelectionMode="Single">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Height" Value="45"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource m_ColName}" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource m_ColAccount}" Binding="{Binding UserName}" Width="180"/>

                    <DataGridTemplateColumn Header="{DynamicResource m_ColRole}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RoleColor}" CornerRadius="15" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding RoleName}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridCheckBoxColumn Header="{DynamicResource m_ColActive}" Binding="{Binding IsActive}" Width="100"/>

                    <DataGridTemplateColumn Header="{DynamicResource m_ColAction}" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" Width="32" Height="32">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="#64748B"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" Width="32" Height="32" Margin="5,0,0,0">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#EF4444"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</Page>