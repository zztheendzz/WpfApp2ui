<Page x:Class="WpfApp2.view.pages.pageCategory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.pages"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="pageCategory"
      TextOptions.TextFormattingMode="Display"
      RenderOptions.EdgeMode="Aliased">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Detail Grid -->
            <RowDefinition Height="120"/>
            <!-- Note -->
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Lưu" Width="80" Margin="5" Command="{Binding SaveCommand}"/>
            <Button Content="Thêm" Width="80" Margin="5" Command="{Binding AddCommand}"/>
            <Button Content="Xóa" Width="80" Margin="5" Command="{Binding DeleteCommand}"/>
            <Button Content="Import Excel" Width="120" Margin="5" Command="{Binding ImportCommand}"/>
        </StackPanel>

        <!-- ===== Header Form ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Row 1 -->
            <TextBlock Text="Model" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Margin="5" Text="{Binding Model}"/>

            <TextBlock Text="Brand" Grid.Column="2" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="3" Margin="5" ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}"/>

            <!-- Row 2 -->
            <TextBlock Text="Vendor" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" Grid.Row="1" Margin="5" ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor}"/>

            <TextBlock Text="Ngày hiệu lực" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center"/>
            <DatePicker Grid.Column="3" Grid.Row="1" Margin="5" SelectedDate="{Binding EffectiveDate}"/>
        </Grid>

        <!-- ===== Detail Grid ===== -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding PriceDetails}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  Margin="0,0,0,10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Model Code" Binding="{Binding ModelCode}" Width="*"/>
                <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="*"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="*"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding Price}" Width="*"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding Total}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== Note ===== -->
        <StackPanel Grid.Row="3">
            <TextBlock Text="Ghi chú"/>
            <TextBox Text="{Binding Note}" AcceptsReturn="True" Height="80"/>
        </StackPanel>

    </Grid>
</Page>