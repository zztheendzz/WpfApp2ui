<Window x:Class="WpfApp2.view.dialog.EditAddPurchase"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{StaticResource ph_GlobalSearch}" 
        Height="620" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{StaticResource title_OrderInfo}" 
                   FontSize="22" FontWeight="Bold" 
                   Margin="0,0,0,20" Foreground="#2D3436"/>

        <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{StaticResource ph_ModelCode}"  Style="{StaticResource LabelStyle}" />
                    <TextBox 
                        IsReadOnly="True"
                        Background="#F1F2F6"
                        Foreground="Black"
                        BorderBrush="#E0E0E0"
                        Text="{Binding ModelCode}"/>

                    <TextBlock Text="{StaticResource ph_ModelName}" Style="{StaticResource LabelStyle}"/>
                    <TextBox IsReadOnly="True" 
                        Background="#F1F2F6"
                        Foreground="Black"
                        BorderBrush="#E0E0E0"
                        Text="{Binding ModelName}"/>

                    <TextBlock Text="{StaticResource lbl_Vendor}" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding VendorName}"/>

                    <TextBlock Text="{StaticResource lbl_Equipment}" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding EquipmentName}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{StaticResource lbl_Currency}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="VND" IsReadOnly="True"
                                     Background="#F1F2F6"
                                     Foreground="Black"
                                     BorderBrush="#E0E0E0"
                                     Cursor="Arrow"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{StaticResource lbl_Quantity}" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Quantity}"
                                     PreviewTextInput="NumberOnly"
                                     DataObject.Pasting="OnPasteNumberOnly"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{StaticResource dg_UnitPrice}" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding UnitPrice}"
                             PreviewTextInput="NumberOnly"
                             DataObject.Pasting="OnPasteDecimalOnly"/>

                    <TextBlock Text="{StaticResource dg_PurchaseDate}" Style="{StaticResource LabelStyle}"/>
                    <DatePicker SelectedDate="{Binding PurchaseDate}" 
                                Height="38" Margin="0,5,0,15"
                                VerticalContentAlignment="Center"/>

                    <TextBlock Text="{StaticResource dg_Note}" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Note}" Height="80" 
                             AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">


            <Button Content="{StaticResource btn_Save}"
                    Width="140" Height="42"
                    Background="#0984E3"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SaveCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#74B9FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{StaticResource btn_Cancel}"
                    Width="120" Height="42"
                    Background="Transparent"
                    Foreground="#636E72"
                    BorderBrush="#B2BEC3"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,15,0"
                    IsCancel="True">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>