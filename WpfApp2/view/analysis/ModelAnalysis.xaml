<Page x:Class="WpfApp2.view.analysis.ModelAnalysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.analysis"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1000"
      Title="ModelAnalysis">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <StackPanel Width="300">
                        <TextBlock Text="{DynamicResource dg_Model}" Margin="0,0,0,5" Foreground="Black" FontWeight="SemiBold" />
                        <Grid>
                            <TextBox x:Name="txtSearchModel" 
                                     materialDesign:HintAssist.Hint=""
                                     Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                            <Popup IsOpen="{Binding IsSearchDropDownOpen}" 
                                   PlacementTarget="{Binding ElementName=txtSearchModel}"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="2"
                                        Width="{Binding ElementName=txtSearchModel, Path=ActualWidth}" MaxHeight="250">
                                    <ListBox x:Name="lstModel" 
                                             DisplayMemberPath="Text" 
                                             BorderThickness="0"
                                             ItemsSource="{Binding SearchSuggestions}" 
                                             SelectedItem="{Binding SelectedSearchResult}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <Button Content="{DynamicResource btn_Analyze}" Width="120" Height="35" VerticalAlignment="Bottom" Margin="10,0,0,0" Command="{Binding AnalyzeCommand}"/>
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!--<Border Background="#2C3E50" Margin="5" Padding="15" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource lbl_LatestPrice}" Foreground="#BDC3C7" FontSize="12"/>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,5,0,0">
                            <Run Text="{Binding AnalysisList.LatestPrice, StringFormat={}{0:N0}}" />
                            <Run Text=" " />
                            <Run Text="{Binding Analysis.CurrencyName}" FontSize="14" Foreground="#95A5A6" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Background="#2C3E50" Margin="5" Padding="15" CornerRadius="5">
                        
                    <StackPanel>
                        <TextBlock Text="{DynamicResource lbl_MinPrice}" Foreground="#BDC3C7" FontSize="12"/>
                        <TextBlock Text="{Binding Analysis.MinPrice , StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#2C3E50" Margin="5" Padding="15" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource lbl_MaxPrice}" Foreground="#BDC3C7" FontSize="12"/>
                        <TextBlock Text="{Binding Analysis.MaxPrice , StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>-->
            </Grid>
            <DockPanel LastChildFill="False" Margin="0,20,0,5">
                <TextBlock Text="Model - Vendor Comparison" 
                           FontWeight="Bold" 
                           FontSize="14" 
                           VerticalAlignment="Center" 
                           DockPanel.Dock="Left"/>
                <Button Command="{Binding ExportExcelCommand}"
                        Background="#27AE60" 
                        Foreground="White"
                        Height="30"
                        Padding="10,0"
                        DockPanel.Dock="Right"
                        ToolTip="Xuất dữ liệu ra file Excel">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Export Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                </Button>
            </DockPanel>
            <DataGrid x:Name="dgMatrix"
                      ItemsSource="{Binding MatrixData.Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      ColumnHeaderHeight="40"
                      MaxHeight="400"
                      Loaded="dgMatrix_Loaded"
                      GridLinesVisibility="All" 
                      HorizontalGridLinesBrush="#CCC" 
                      VerticalGridLinesBrush="#CCC"
                      RowHeaderWidth="0" 
                      BorderBrush="#999"
                      BorderThickness="1"
                      AlternatingRowBackground="#F9F9F9"
                      HorizontalScrollBarVisibility="Auto"/>

            <TextBlock Text="{DynamicResource lbl_PurchaseHistory}" FontWeight="Bold" FontSize="14" Margin="0,20,0,5"/>
            <DataGrid ItemsSource="{Binding AnalysisItems}" 
          AutoGenerateColumns="False" 
          IsReadOnly="True" 
          MaxHeight="300" 
          ColumnHeaderHeight="40"
          GridLinesVisibility="Horizontal" 
          HorizontalGridLinesBrush="#EEE">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource dg_Id}" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_Model}" Width="Auto" MinWidth="100" Binding="{Binding ModelName}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_ModelCode}" Width="Auto" MinWidth="100" Binding="{Binding ModelCode}"/>

                    <DataGridTextColumn Header="{DynamicResource dg_Equipment}" Width="Auto" MinWidth="100" Binding="{Binding EquipmentName}"/>

                    <DataGridTextColumn Header="{DynamicResource dg_UnitPrice}" Binding="{Binding UnitPrice, StringFormat='N0'}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_PurchaseDate}" Binding="{Binding PurchaseDate, StringFormat='dd/MM/yyyy'}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_Note}" Width="*" Binding="{Binding Note}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</Page>