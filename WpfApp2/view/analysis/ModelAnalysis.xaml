<Page x:Class="WpfApp2.view.analysis.ModelAnalysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.analysis"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1100"
      Title="ModelAnalysis"
      TextOptions.TextFormattingMode="Display"
      RenderOptions.EdgeMode="Aliased">

    <Page.Resources>
        <SolidColorBrush x:Key="MainNavy" Color="#162D46"/>
        <SolidColorBrush x:Key="SubBlue" Color="#254D76"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3A75B0"/>
        <DropShadowEffect x:Key="CommonShadow" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect" Value="{StaticResource CommonShadow}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="{StaticResource MainNavy}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MainNavy}">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Cube" Foreground="White" Width="18" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource menu_Inquiry_Model}" Foreground="White" FontSize="15" FontWeight="Medium"/>
                    <TextBlock Text=" - Analysis &amp; Comparison" Foreground="#88FFFFFF" FontSize="14" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="{DynamicResource dg_ModelCode}" FontSize="10" Foreground="Gray" Margin="2,0,0,2"/>
                    <Grid>
                        <TextBox x:Name="txtSearchModel" Width="300" Height="32" VerticalContentAlignment="Center" Padding="8,0,30,0"
                                 Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <fa:ImageAwesome Icon="Search" Foreground="#CCC" Width="12" HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False"/>

                        <Popup IsOpen="{Binding IsSearchDropDownOpen}" PlacementTarget="{Binding ElementName=txtSearchModel}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="300" MaxHeight="300" Margin="0,2,0,0">
                                <ListBox x:Name="lstModel" 
                                         ItemsSource="{Binding SearchSuggestions}" 
                                         SelectedItem="{Binding SelectedSearchResult}"
                                         DisplayMemberPath="Text" BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,8"/>
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F7FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <Button Content="{DynamicResource btn_Analyze}" VerticalAlignment="Bottom" Height="32" Margin="10,0,0,0"
                        Command="{Binding AnalyzeCommand}"
                        Background="{StaticResource AccentBlue}" Foreground="White" Padding="25,0" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:ImageAwesome Icon="Exchange" Foreground="{StaticResource AccentBlue}" Width="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource title_MatrixComparison}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource MainNavy}"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" 
                                    Command="{Binding ExportExcelCommand}"
                                    Background="#27AE60" Foreground="White" BorderThickness="0" Height="28" Padding="12,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcel" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource btn_ExportExcel}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <DataGrid x:Name="dgMatrix"
          ItemsSource="{Binding MatrixData.Rows}"
          AutoGenerateColumns="False"
          MaxHeight="450"
          GridLinesVisibility="All"
          HorizontalGridLinesBrush="#F0F0F0"
          VerticalGridLinesBrush="#F0F0F0"
          HeadersVisibility="All">

                            <DataGrid.Columns>

                                <DataGridTextColumn Binding="{Binding ModelName}" Width="Auto">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_Model}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5,0"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding ModelCode}" Width="Auto">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_ModelCode}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5,0"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>

                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="8,10,8,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
                            <fa:ImageAwesome Icon="History" Foreground="{StaticResource AccentBlue}" Width="16" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource lbl_PurchaseHistory}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource MainNavy}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding AnalysisItems}" MaxHeight="400">
                            <DataGrid.Columns>

                                <DataGridTextColumn Binding="{Binding Id}" Width="60">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_Id}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="1*" Binding="{Binding ModelName}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_Model}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="1*" Binding="{Binding ModelCode}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_ModelCode}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Image"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Image}" 
                                   Stretch="Uniform" 
                                   MaxHeight="50" 
                                   Width="80"
                                   Margin="5"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="1*" Binding="{Binding EquipmentName}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_Equipment}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="1*" Binding="{Binding VendorName}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_Vendor}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="120" Binding="{Binding UnitPrice, StringFormat='N0'}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_UnitPrice}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,0,12,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="110" Binding="{Binding PurchaseDate, StringFormat='dd/MM/yyyy'}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_PurchaseDate}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="1.5*" Binding="{Binding Note}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dg_Note}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>