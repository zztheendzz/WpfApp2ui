<Page x:Class="WpfApp2.view.analysis.VendorAnalysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.analysis"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="VendorAnalysis"
      TextOptions.TextFormattingMode="Display"
      RenderOptions.EdgeMode="Aliased">

    <Page.Resources>
        <SolidColorBrush x:Key="MainNavy" Color="#162D46"/>
        <SolidColorBrush x:Key="SubBlue" Color="#254D76"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3A75B0"/>
        <DropShadowEffect x:Key="CommonShadow" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect" Value="{StaticResource CommonShadow}"/>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="{StaticResource MainNavy}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MainNavy}">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Industry" Foreground="White" Width="18" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource menu_Inquiry_Vendor}" Foreground="White" FontSize="15" FontWeight="Medium"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="{DynamicResource ph_Vendor}" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                    <Grid>
                        <TextBox x:Name="txtSearchVendor" Width="250" Height="30" VerticalContentAlignment="Center" Padding="5,0,25,0"
                                 Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <fa:ImageAwesome Icon="Search" Foreground="#CCC" Width="12" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <Popup IsOpen="{Binding IsSearchDropDownOpen}" PlacementTarget="{Binding ElementName=txtSearchVendor}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="250" MaxHeight="300">
                                <ListBox x:Name="lstVendor" ItemsSource="{Binding SearchSuggestions}" SelectedItem="{Binding SelectedSearchResult}" BorderThickness="0" DisplayMemberPath="Text">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource ph_DateFrom}" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                    <DatePicker Width="120" SelectedDate="{Binding FromDate}"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="{DynamicResource ph_DateTo}" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                    <DatePicker Width="120" SelectedDate="{Binding ToDate}"/>
                </StackPanel>

                <Button Content="{DynamicResource btn_Analyze}" VerticalAlignment="Bottom" Height="30" Margin="10,0,0,2"
                        Command="{Binding AnalyzeCommand}"
                        Background="{StaticResource AccentBlue}" Foreground="White" Padding="25,0" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Margin="10,5">
            <Border Background="{StaticResource SubBlue}" CornerRadius="5" Margin="6" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Money" Foreground="#FFD700" Width="25"/>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="{DynamicResource lbl_TotalPurchaseValue}" Foreground="White" Opacity="0.8" FontSize="11"/>
                        <TextBlock Text="{Binding Analysis.TotalPrice, StringFormat={}{0:N0} VND}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SubBlue}" CornerRadius="5" Margin="6" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Truck" Foreground="White" Width="25"/>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="{DynamicResource lbl_SupplyCount}" Foreground="White" Opacity="0.8" FontSize="11"/>
                        <TextBlock Text="{Binding Analysis.TotalTransactions}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SubBlue}" CornerRadius="5" Margin="6" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Star" Foreground="#90EE90" Width="25"/>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="{DynamicResource dg_Model}" Foreground="White" Opacity="0.8" FontSize="11"/>
                        <TextBlock Text="{Binding TopModelDisplay}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Height="280" Padding="15">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource lbl_TotalPurchaseValue}" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                            <lvc:CartesianChart x:Name="ChartMonthlySpend" LegendLocation="None">
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="VND" MinValue="0"/>
                                </lvc:CartesianChart.AxisY>
                                <lvc:CartesianChart.Series>
                                    <lvc:ColumnSeries Title="Value" Values="{Binding MonthlyValues}" Fill="{StaticResource AccentBlue}"/>
                                </lvc:CartesianChart.Series>
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding MonthlyLabels}"/>
                                </lvc:CartesianChart.AxisX>
                            </lvc:CartesianChart>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Height="280" Padding="15">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource lbl_UsageRate}" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                            <lvc:PieChart Series="{Binding PieSeriesCollection}" LegendLocation="Bottom" InnerRadius="30"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="5">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10,8">
                        <TextBlock Text="{DynamicResource lbl_PurchasedPartsList}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text=": " FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding Analysis.VendorName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBlue}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Analysis.Items}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="90" Binding="{Binding PurchaseDate, StringFormat='dd/MM/yyyy'}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource dg_PurchaseDate}"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="2*" Binding="{Binding ModelName}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource ph_ModelName}"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="*" Binding="{Binding ModelCode}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource dg_ModelCode}"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Image"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Image}" 
                                   Stretch="Uniform" 
                                   MaxHeight="50" 
                                   Width="80"
                                   Margin="5"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="*" Binding="{Binding EquipmentName}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource ph_Equipment}"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="60" Binding="{Binding Quantity, StringFormat={}{0:N0}}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource dg_Quantity}"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="110" Binding="{Binding LineTotal, StringFormat={}{0:N0}}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource dg_TotalPrice}"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource SubBlue}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="90" Binding="{Binding FullName}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource dg_User}"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>