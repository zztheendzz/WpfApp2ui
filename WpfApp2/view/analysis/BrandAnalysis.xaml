<Page x:Class="WpfApp2.view.analysis.BrandAnalysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.analysis"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="BrandAnalysis"
      TextOptions.TextFormattingMode="Display"
      RenderOptions.EdgeMode="Aliased"
      RenderOptions.BitmapScalingMode="LowQuality">

    <Page.Resources>
        <SolidColorBrush x:Key="MainNavy" Color="#162D46"/>
        <SolidColorBrush x:Key="SubBlue" Color="#254D76"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3A75B0"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="{StaticResource MainNavy}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MainNavy}">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="BarChart" Foreground="White" Width="18" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource menu_Inquiry_Brand}" Foreground="White" FontSize="15" FontWeight="Medium"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="{DynamicResource lbl_Brand}" FontSize="10" Foreground="Gray"/>
                    <Grid>
                        <TextBox x:Name="TxtSearch" Width="250" Height="30" VerticalContentAlignment="Center" Padding="5,0,25,0"
                                 Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <fa:ImageAwesome Icon="Search" Foreground="#CCC" Width="12" HorizontalAlignment="Right" Margin="0,0,8,0" IsHitTestVisible="False"/>
                        <Popup IsOpen="{Binding IsSearchDropDownOpen}" PlacementTarget="{Binding ElementName=TxtSearch}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="250" MaxHeight="300">
                                <ListBox x:Name="LstSuggestions" ItemsSource="{Binding SearchSuggestions}" SelectedItem="{Binding SelectedSearchResult}"
                                         DisplayMemberPath="Text" BorderThickness="0" PreviewMouseLeftButtonDown="OnListBoxItemClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource ph_DateFrom}" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                    <DatePicker Width="120" SelectedDate="{Binding FromDate}"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="{DynamicResource ph_DateTo}" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                    <DatePicker Width="120" SelectedDate="{Binding ToDate}"/>
                </StackPanel>

                <Button Content="{DynamicResource btn_Analyze}" VerticalAlignment="Bottom" Height="30" Margin="10,0,0,2"
                        Command="{Binding AnalyzeCommand}" Background="{StaticResource AccentBlue}" Foreground="White" Padding="25,0" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Margin="10,5">
            <Border Background="{StaticResource SubBlue}" Style="{StaticResource CardStyle}" BorderThickness="0" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Money" Foreground="#FFD700" Width="25"/>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="{DynamicResource lbl_TotalPurchaseValue}" Foreground="White" Opacity="0.8" FontSize="11"/>
                        <TextBlock Text="{Binding Analysis.TotalPrice, StringFormat={}{0:N0} VND}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SubBlue}" Style="{StaticResource CardStyle}" BorderThickness="0" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Truck" Foreground="White" Width="25"/>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="{DynamicResource lbl_SupplyCount}" Foreground="White" Opacity="0.8" FontSize="11"/>
                        <TextBlock Text="{Binding Analysis.TotalTransactions}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SubBlue}" Style="{StaticResource CardStyle}" BorderThickness="0" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Star" Foreground="#90EE90" Width="25"/>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="{DynamicResource dg_Model}" Foreground="White" Opacity="0.8" FontSize="11"/>
                        <TextBlock Text="{Binding TopModelDisplay}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Height="280" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource lbl_UsageRate}" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                            <lvc:PieChart Series="{Binding PieSeriesCollection}" LegendLocation="None" InnerRadius="20" DisableAnimations="True" Hoverable="True">
                                <lvc:PieChart.DataTooltip>
                                    <lvc:DefaultTooltip BulletSize="10" Background="#2B2B2B" Foreground="White"/>
                                </lvc:PieChart.DataTooltip>
                            </lvc:PieChart>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Height="300" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource lbl_TotalPurchaseValue}" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                            <lvc:CartesianChart x:Name="ChartBrandMonthly" DisableAnimations="True">
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="VND" MinValue="0"/>
                                </lvc:CartesianChart.AxisY>
                                <lvc:CartesianChart.Series>
                                    <lvc:ColumnSeries Title="Value" Values="{Binding MonthlyValues}" Fill="{StaticResource AccentBlue}"/>
                                </lvc:CartesianChart.Series>
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding MonthlyLabels}"/>
                                </lvc:CartesianChart.AxisX>
                            </lvc:CartesianChart>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="5">
                <DataGrid ItemsSource="{Binding Analysis.Items}" SelectionMode="Single" ScrollViewer.CanContentScroll="True" RowHeight="50">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource dg_PurchaseDate}" Width="110" Binding="{Binding PurchaseDate, StringFormat='dd/MM/yyyy'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="{DynamicResource ph_ModelName}" MinWidth="150" Width="Auto" Binding="{Binding ModelName}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="5,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="{DynamicResource ph_Equipment}" Width="Auto" Binding="{Binding EquipmentName}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="{DynamicResource dg_Quantity}" Width="80" Binding="{Binding Quantity}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="{DynamicResource dg_TotalPrice}" Width="130" Binding="{Binding LineTotal, StringFormat={}{0:N0}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource SubBlue}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Page>