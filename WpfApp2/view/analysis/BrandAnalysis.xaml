<Page x:Class="WpfApp2.view.analysis.BrandAnalysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.analysis"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="BrandAnalysis"
      TextOptions.TextFormattingMode="Display"
      RenderOptions.EdgeMode="Aliased">

    <Page.Resources>
        <SolidColorBrush x:Key="MainNavy" Color="#162D46"/>
        <SolidColorBrush x:Key="SubBlue" Color="#254D76"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3A75B0"/>
        <DropShadowEffect x:Key="CommonShadow" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect" Value="{StaticResource CommonShadow}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="{StaticResource MainNavy}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MainNavy}">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="BarChart" Foreground="White" Width="18" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource menu_Inquiry}" Foreground="White" FontSize="15" FontWeight="Medium"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="{DynamicResource lbl_Brand}" FontSize="10" Foreground="Gray"/>
                    <Grid>
                        <TextBox x:Name="TxtSearch" Width="220" Height="30" VerticalContentAlignment="Center" Padding="5,0,25,0"
                                 Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>

                        <fa:ImageAwesome Icon="Search" Foreground="#CCC" Width="12" HorizontalAlignment="Right" Margin="0,0,8,0" IsHitTestVisible="False"/>

                        <Popup IsOpen="{Binding IsSearchDropDownOpen}" PlacementTarget="{Binding ElementName=TxtSearch}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="220" MaxHeight="300">
                                <ListBox x:Name="LstSuggestions" 
                                         ItemsSource="{Binding SearchSuggestions}" 
                                         SelectedItem="{Binding SelectedSearchResult}"
                                         DisplayMemberPath="Text" BorderThickness="0"
                                         PreviewMouseLeftButtonDown="OnListBoxItemClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource ph_DateFrom}" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                    <DatePicker Width="120" SelectedDate="{Binding FromDate}"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="{DynamicResource ph_DateTo}" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                    <DatePicker Width="120" SelectedDate="{Binding ToDate}"/>
                </StackPanel>

                <Button Content="{DynamicResource btn_Analyze}" VerticalAlignment="Bottom" Height="30" Margin="10,0,0,2"
                        Command="{Binding AnalyzeCommand}"
                        Background="{StaticResource AccentBlue}" Foreground="White" Padding="25,0" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="3">
                    <Border Background="{StaticResource SubBlue}" CornerRadius="5" Margin="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                            <fa:ImageAwesome Icon="Money" Foreground="#FFD700" Width="30"/>
                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="{DynamicResource lbl_TotalPurchaseValue}" Foreground="White" Opacity="0.8" FontSize="11"/>
                                <TextBlock Text="{Binding Analysis.TotalPrice, StringFormat={}{0:N0} VND}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SubBlue}" CornerRadius="5" Margin="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                            <fa:ImageAwesome Icon="Exchange" Foreground="White" Width="30"/>
                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="{DynamicResource lbl_SupplyCount}" Foreground="White" Opacity="0.8" FontSize="11"/>
                                <TextBlock Text="{Binding Analysis.TotalTransactions}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SubBlue}" CornerRadius="5" Margin="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                            <fa:ImageAwesome Icon="PieChart" Foreground="#90EE90" Width="30"/>
                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="{DynamicResource dg_Model}" Foreground="White" Opacity="0.8" FontSize="11"/>
                                <TextBlock Text="{Binding TopModelDisplay}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource lbl_TotalPurchaseValue}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <lvc:CartesianChart x:Name="ChartBrandMonthly" Grid.Row="1" Height="220" LegendLocation="None">
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="VND" MinValue="0"/>
                                </lvc:CartesianChart.AxisY>
                                <lvc:CartesianChart.Series>
                                    <lvc:ColumnSeries Title="Value" Values="{Binding MonthlyValues}" Fill="{StaticResource AccentBlue}"/>
                                </lvc:CartesianChart.Series>
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding MonthlyLabels}"/>
                                </lvc:CartesianChart.AxisX>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource lbl_UsageRate}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <lvc:PieChart Grid.Row="1" Series="{Binding PieSeriesCollection}" LegendLocation="Right" InnerRadius="40"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="15">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource lbl_PurchasedPartsList}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Analysis.Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource dg_PurchaseDate}" Width="auto" Binding="{Binding PurchaseDate, StringFormat='dd/MM/yyyy'}"/>
                                <DataGridTextColumn Header="{DynamicResource ph_ModelName}" Width="auto" Binding="{Binding ModelName}"/>
                                <DataGridTextColumn Header="{DynamicResource dg_ModelCode}" Width="auto" Binding="{Binding ModelCode}"/>
                                <DataGridTextColumn Header="{DynamicResource ph_Equipment}" Width="auto" Binding="{Binding EquipmentName}"/>
                                <DataGridTextColumn Header="{DynamicResource dg_Quantity}" Width="auto" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="{DynamicResource dg_UnitPrice}" Width="auto" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="{DynamicResource dg_TotalPrice}" Width="auto" Binding="{Binding LineTotal, StringFormat={}{0:N0}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource MainNavy}" Padding="10,5">
            <UniformGrid Columns="4">
                <Button Style="{StaticResource FooterButtonStyle}" Command="{Binding NavModelAnalysis}">
                    <StackPanel>
                        <fa:ImageAwesome Icon="Cube" Foreground="White" Width="16" Margin="0,0,0,3"/>
                        <TextBlock Text="Model" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterButtonStyle}" Command="{Binding NavVendorAnalysis}">
                    <StackPanel>
                        <fa:ImageAwesome Icon="Industry" Foreground="White" Width="16" Margin="0,0,0,3"/>
                        <TextBlock Text="{DynamicResource ph_Vendor}" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterButtonStyle}" Tag="Active">
                    <StackPanel>
                        <fa:ImageAwesome Icon="Flash" Foreground="White" Width="16" Margin="0,0,0,3"/>
                        <TextBlock Text="{DynamicResource lbl_Brand}" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterButtonStyle}" Command="{Binding NavEquipmentAnalysis}">
                    <StackPanel>
                        <fa:ImageAwesome Icon="Wrench" Foreground="White" Width="16" Margin="0,0,0,3"/>
                        <TextBlock Text="{DynamicResource ph_Equipment}" FontSize="10"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</Page>