<Page x:Class="WpfApp2.view.analysis.PurchaseAnalysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.analysis"
      xmlns:vm="clr-namespace:WpfApp2.viewmodel.analysis"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="1200" d:DesignWidth="1100"
      Title="PurchaseAnalysis">

    <Page.DataContext>
        <vm:PurchaseAnalysisVm/>
    </Page.DataContext>

    <Page.Resources>
        <SolidColorBrush x:Key="MainNavy" Color="#162D46"/>
        <SolidColorBrush x:Key="SubBlue" Color="#254D76"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3A75B0"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#27AE60"/>
        <DropShadowEffect x:Key="CommonShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.1"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect" Value="{StaticResource CommonShadow}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="{StaticResource MainNavy}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F5F6F7">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">

                <materialDesign:Card Padding="15" Margin="0,0,0,15" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource menu_Inquiry_Purchase}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50"/>

                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Width="220" Margin="5">
                                <TextBlock Text="{DynamicResource dg_ModelCode}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#666"/>
                                <Grid>
                                    <TextBox x:Name="txtSearchModel" Tag="M" Text="{Binding SearchModelText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                    <Popup IsOpen="{Binding IsDropDownOpenM}" PlacementTarget="{Binding ElementName=txtSearchModel}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="{Binding ElementName=txtSearchModel, Path=ActualWidth}">
                                            <ListBox x:Name="lstModel" DisplayMemberPath="Text" ItemsSource="{Binding ModelSuggestions}" SelectedItem="{Binding SelectedModel}">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Width="220" Margin="5">
                                <TextBlock Text="{DynamicResource ph_Vendor}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#666"/>
                                <Grid>
                                    <TextBox x:Name="txtSearchVendor" Tag="V" Text="{Binding SearchVendorText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                    <Popup IsOpen="{Binding IsDropDownOpenV}" PlacementTarget="{Binding ElementName=txtSearchVendor}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="{Binding ElementName=txtSearchVendor, Path=ActualWidth}">
                                            <ListBox x:Name="lstVendor" DisplayMemberPath="Text" ItemsSource="{Binding VendorSuggestions}" SelectedItem="{Binding SelectedVendor}">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Width="220" Margin="5">
                                <TextBlock Text="{DynamicResource ph_Equipment}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#666"/>
                                <Grid>
                                    <TextBox x:Name="txtSearchEquip" Tag="E" Text="{Binding SearchEquipmentText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                    <Popup IsOpen="{Binding IsDropDownOpenE}" PlacementTarget="{Binding ElementName=txtSearchEquip}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="{Binding ElementName=txtSearchEquip, Path=ActualWidth}">
                                            <ListBox x:Name="lstEquip" DisplayMemberPath="Text" ItemsSource="{Binding EquipmentSuggestions}" SelectedItem="{Binding SelectedEquipment}">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Width="220" Margin="5">
                                <TextBlock Text="{DynamicResource ph_Brand}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#666"/>
                                <Grid>
                                    <TextBox x:Name="txtSearchBrand" Tag="B" Text="{Binding SearchBrandText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                    <Popup IsOpen="{Binding IsDropDownOpenB}" PlacementTarget="{Binding ElementName=txtSearchBrand}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="{Binding ElementName=txtSearchBrand, Path=ActualWidth}">
                                            <ListBox x:Name="lstBrand" DisplayMemberPath="Text" ItemsSource="{Binding BrandSuggestions}" SelectedItem="{Binding SelectedBrand}">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="5,15,0,0" VerticalAlignment="Center">
                            <DatePicker Width="130" SelectedDate="{Binding SelectedDateFrom}" materialDesign:HintAssist.Hint="{DynamicResource ph_DateFrom}" Margin="0,0,10,0"/>
                            <DatePicker Width="130" SelectedDate="{Binding SelectedDateTo}" materialDesign:HintAssist.Hint="{DynamicResource ph_DateTo}" Margin="0,0,20,0"/>

                            <TextBlock Text="{DynamicResource ph_MinPrice}" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#666"/>
                            <xctk:DoubleUpDown Value="{Binding PriceMin}" Width="100" Margin="0,0,10,0" FormatString="N0" VerticalAlignment="Center"/>

                            <TextBlock Text="{DynamicResource ph_MaxPrice}" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#666"/>
                            <xctk:DoubleUpDown Value="{Binding PriceMax}" Width="100" Margin="0,0,20,0" FormatString="N0" VerticalAlignment="Center"/>

                            <Button Content="{DynamicResource btn_Analyze}" 
                Background="{StaticResource AccentBlue}" 
                Command="{Binding SearchCommand}" 
                Foreground="White" 
                Width="120" Height="32" 
                BorderThickness="0" 
                FontWeight="SemiBold" 
                Margin="0,0,5,0"/>

                            <Button Content="{DynamicResource btn_Clear}" 
                Command="{Binding ClearCommand}" 
                Width="Auto" Height="32" 
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Margin="0,0,5,0"/>

                            <Button Content="{DynamicResource btn_ExportExcel}" 
                Command="{Binding ExportExcelPurchase}" 
                Width="Auto" Height="32" 
                Style="{StaticResource MaterialDesignOutlinedButton}"/>


                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <UniformGrid Columns="4" Margin="0,0,0,15">
                    <materialDesign:Card Background="#2C3E50" Foreground="White" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_TotalPurchaseValue}" FontSize="11" Opacity="0.7"/>
                            <TextBlock Margin="0,5,0,0" FontWeight="Bold" FontSize="20">
                                <Run Text="{Binding Analysis.GrandTotal, StringFormat={}{0:N0} VND}"/>
                                <Run Text=" " FontSize="12"/><Run Text="{Binding Analysis.CurrencyName}" FontSize="12"/>
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Background="#27AE60" Foreground="White" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_MinPrice}" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding Analysis.MinPrice, StringFormat={}{0:N0} VND}" Margin="0,5,0,0" FontWeight="Bold" FontSize="20"/>
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Background="#E67E22" Foreground="White" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_AvgPrice}" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding Analysis.AvgPrice, StringFormat={}{0:N0} VND}" Margin="0,5,0,0" FontWeight="Bold" FontSize="20"/>
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Background="#E74C3C" Foreground="White" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_MaxPrice}" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding Analysis.MaxPrice, StringFormat={}{0:N0} VND}" Margin="0,5,0,0" FontWeight="Bold" FontSize="20"/>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <materialDesign:Card Padding="0" Margin="5" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <Grid Margin="15,10">
                            <TextBlock Text="{DynamicResource lbl_PurchasedPartsList}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2C3E50"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource lbl_TotalRecords}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Analysis.TotalRecord}" FontWeight="Bold" Foreground="#1976D2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding Analysis.Items}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  CanUserSortColumns="True" Background="White"
                                  MinHeight="300" MaxHeight="600" materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{DynamicResource dg_PurchaseDate}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PurchaseDate, StringFormat=dd/MM/yyyy}" Padding="5" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource dg_Model}" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModelName}" TextWrapping="Wrap" Padding="5" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource dg_ModelCode}" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModelCode}" TextWrapping="Wrap" Padding="5" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.Header>
                                        <!--<TextBlock Text="{DynamicResource dg_Image}"/>-->
                                        <TextBlock Text="Image"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Image}" 
                                  Stretch="Uniform" 
                                  MaxHeight="50" 
                                  Width="80"
                                  Margin="5"
                                  RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource ph_Vendor}" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VendorName}" TextWrapping="Wrap" Padding="5" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource ph_Brand}" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BrandName}" TextWrapping="Wrap" Padding="5" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource dg_Quantity}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource dg_UnitPrice}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0}}" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource dg_TotalPrice}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}}" FontWeight="Bold" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Header="{DynamicResource dg_Currency}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CurrencyName}" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource dg_User}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FullName}" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>


                                <DataGridTemplateColumn Header="{DynamicResource dg_Note}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Padding="5" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>



                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                            <Button Content="&lt;" Command="{Binding PrevCommand}" Style="{StaticResource MaterialDesignFlatButton}"/>
                            <Border Background="#1976D2" CornerRadius="15" Width="30" Height="30" Margin="10,0">
                                <TextBlock Text="{Binding CurrentPage}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <Button Content="&gt;" Command="{Binding NextCommand}" Style="{StaticResource MaterialDesignFlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>