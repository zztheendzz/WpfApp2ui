<Page x:Class="WpfApp2.view.analysis.PurchaseAnalysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.analysis"
      xmlns:vm="clr-namespace:WpfApp2.viewmodel.analysis"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="1200" d:DesignWidth="1100"
      Title="PurchaseAnalysis">

    <Page.DataContext>
        <vm:PurchaseAnalysisVm/>
    </Page.DataContext>

    <Grid Background="#F5F6F7">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">

                <materialDesign:Card Padding="15" Margin="0,0,0,15" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource menu_Inquiry}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50"/>
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Width="220" Margin="5">
                                <TextBlock Text="{DynamicResource dg_ModelCode}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#666"/>
                                <Grid>
                                    <TextBox x:Name="txtSearchModel" Tag="M" Text="{Binding SearchModelText, UpdateSourceTrigger=PropertyChanged}" 
                                             PreviewKeyDown="SearchBox_PreviewKeyDown" materialDesign:HintAssist.Hint="..."/>
                                    <Popup IsOpen="{Binding IsDropDownOpenM}" PlacementTarget="{Binding ElementName=txtSearchModel}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="{Binding ElementName=txtSearchModel, Path=ActualWidth}">
                                            <ListBox x:Name="lstModel" DisplayMemberPath="Text" ItemsSource="{Binding ModelSuggestions}" SelectedItem="{Binding SelectedModel}">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Width="220" Margin="5">
                                <TextBlock Text="{DynamicResource ph_Vendor}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#666"/>
                                <Grid>
                                    <TextBox x:Name="txtSearchVendor" Tag="V" Text="{Binding SearchVendorText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                    <Popup IsOpen="{Binding IsDropDownOpenV}" PlacementTarget="{Binding ElementName=txtSearchVendor}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="{Binding ElementName=txtSearchVendor, Path=ActualWidth}">
                                            <ListBox x:Name="lstVendor" DisplayMemberPath="Text" ItemsSource="{Binding VendorSuggestions}" SelectedItem="{Binding SelectedVendor}">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Width="220" Margin="5">
                                <TextBlock Text="{DynamicResource ph_Equipment}" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#666"/>
                                <Grid>
                                    <TextBox x:Name="txtSearchEquip" Tag="E" Text="{Binding SearchEquipmentText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                    <Popup IsOpen="{Binding IsDropDownOpenE}" PlacementTarget="{Binding ElementName=txtSearchEquip}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="{Binding ElementName=txtSearchEquip, Path=ActualWidth}">
                                            <ListBox x:Name="lstEquip" DisplayMemberPath="Text" ItemsSource="{Binding EquipmentSuggestions}" SelectedItem="{Binding SelectedEquipment}">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <Button Content="{DynamicResource btn_Analyze}" Command="{Binding SearchCommand}" Margin="10,20,5,0" Width="100" Height="38"/>
                            <Button Content="{DynamicResource btn_Clear}" Command="{Binding ClearCommand}" Margin="5,20,0,0" Width="100" Height="38" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="5,15,0,0">
                            <DatePicker Width="130" SelectedDate="{Binding SelectedDateFrom}" materialDesign:HintAssist.Hint="{DynamicResource ph_DateFrom}" Margin="0,0,10,0"/>
                            <DatePicker Width="130" SelectedDate="{Binding SelectedDateTo}" materialDesign:HintAssist.Hint="{DynamicResource ph_DateTo}" Margin="0,0,20,0"/>
                            <TextBlock Text="{DynamicResource ph_MinPrice}" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#666"/>
                            <xctk:DoubleUpDown Value="{Binding PriceMin}" Width="100" Margin="0,0,10,0" FormatString="N0"/>
                            <TextBlock Text="{DynamicResource ph_MaxPrice}" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#666"/>
                            <xctk:DoubleUpDown Value="{Binding PriceMax}" Width="100" FormatString="N0"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <UniformGrid Columns="4" Margin="0,0,0,15">
                    <materialDesign:Card Background="#2C3E50" Foreground="White" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_LatestPrice}" FontSize="11" Opacity="0.7"/>
                            <TextBlock Margin="0,5,0,0" FontWeight="Bold" FontSize="20">
                                <Run Text="{Binding Analysis.LastPrice, StringFormat={}{0:N0}}"/>
                                <Run Text=" " FontSize="12"/><Run Text="{Binding Analysis.CurrencyName}" FontSize="12"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Analysis.LastVendorName}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Background="#27AE60" Foreground="White" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_MinPrice}" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding Analysis.MinPrice, StringFormat={}{0:N0}}" Margin="0,5,0,0" FontWeight="Bold" FontSize="20"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Background="#E67E22" Foreground="White" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_AvgPrice}" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding Analysis.AvgPrice, StringFormat={}{0:N0}}" Margin="0,5,0,0" FontWeight="Bold" FontSize="20"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Background="#E74C3C" Foreground="White" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_MaxPrice}" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding Analysis.MaxPrice, StringFormat={}{0:N0}}" Margin="0,5,0,0" FontWeight="Bold" FontSize="20"/>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_VendorComparison}" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2C3E50"/>
                            <lvc:CartesianChart x:Name="ChartVendor" Series="{Binding VendorPriceSeries}" Height="250" LegendLocation="None">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="{DynamicResource ph_Vendor}" Labels="{Binding VendorLabels}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Step="1" IsEnabled="False"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="VNĐ" LabelFormatter="{Binding YFormatter}" MinValue="0"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Margin="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource lbl_TotalPurchaseValue}" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2C3E50"/>
                            <lvc:CartesianChart x:Name="ChartTrend" Series="{Binding PriceTrendSeries}" Height="250" LegendLocation="None">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="{DynamicResource dg_PurchaseDate}" Labels="{Binding TrendLabels}"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis LabelFormatter="{Binding YFormatter}"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <materialDesign:Card Padding="0" Margin="5" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <Grid Margin="15,10">
                            <TextBlock Text="{DynamicResource lbl_PurchasedPartsList}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2C3E50"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource lbl_TotalRecords}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Foreground="#1976D2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding PurchaseDtos}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  CanUserSortColumns="True" Background="White"
                                  MinHeight="300" MaxHeight="600" materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource dg_PurchaseDate}" Binding="{Binding PurchaseDate, StringFormat=dd/MM/yyyy}"/>
                                <DataGridTextColumn Header="{DynamicResource dg_Model}" Binding="{Binding ModelName}"/>
                                <DataGridTextColumn Header="{DynamicResource ph_Vendor}" Binding="{Binding VendorName}" Width="150"/>
                                <DataGridTextColumn Header="{DynamicResource ph_Equipment}" Binding="{Binding EquipmentName}"/>
                                <DataGridTextColumn Header="{DynamicResource dg_Quantity}" Binding="{Binding Quantity, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="{DynamicResource dg_UnitPrice}" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="{DynamicResource dg_TotalPrice}" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                                <DataGridTextColumn Header="{DynamicResource dg_Currency}" Binding="{Binding CurrencyName}"/>
                                <DataGridTextColumn Header="{DynamicResource dg_Note}" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                            <Button Content="&lt;" Command="{Binding PrevCommand}" Style="{StaticResource MaterialDesignFlatButton}"/>
                            <Border Background="#1976D2" CornerRadius="15" Width="30" Height="30" Margin="10,0">
                                <TextBlock Text="{Binding CurrentPage}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <Button Content="&gt;" Command="{Binding NextCommand}" Style="{StaticResource MaterialDesignFlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>