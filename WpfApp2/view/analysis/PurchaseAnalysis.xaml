<Page x:Class="WpfApp2.view.analysis.PurchaseAnalysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.analysis"
      xmlns:vm="clr-namespace:WpfApp2.viewmodel.analysis"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1100"
      Title="PurchaseAnalysis">

    <Page.DataContext>
        <vm:PurchaseAnalysisVm/>
    </Page.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">

                <StackPanel Width="220" Margin="5">
                    <TextBlock Text="Model:" Margin="0,0,0,5" Foreground="#666"/>
                    <Grid>
                        <TextBox x:Name="txtSearchModel" Tag="M"
                                 materialDesign:HintAssist.Hint="{DynamicResource ph_Model}"
                                 Text="{Binding SearchModelText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <Popup IsOpen="{Binding IsDropDownOpenM}" PlacementTarget="{Binding ElementName=txtSearchModel}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="2"
                                    Width="{Binding ElementName=txtSearchModel, Path=ActualWidth}" MaxHeight="250">
                                <ListBox x:Name="lstModel" DisplayMemberPath="Text" BorderThickness="0"
                                         ItemsSource="{Binding ModelSuggestions}" SelectedItem="{Binding SelectedModel}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Width="220" Margin="5">
                    <TextBlock Text="{DynamicResource ph_Vendor}" Margin="0,0,0,5" Foreground="#666"/>
                    <Grid>
                        <TextBox x:Name="txtSearchVendor" Tag="V"
                                 materialDesign:HintAssist.Hint=""
                                 Text="{Binding SearchVendorText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <Popup IsOpen="{Binding IsDropDownOpenV}" PlacementTarget="{Binding ElementName=txtSearchVendor}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="2"
                                    Width="{Binding ElementName=txtSearchVendor, Path=ActualWidth}" MaxHeight="250">
                                <ListBox x:Name="lstVendor" DisplayMemberPath="Text" BorderThickness="0"
                                         ItemsSource="{Binding VendorSuggestions}" SelectedItem="{Binding SelectedVendor}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Width="220" Margin="5">
                    <TextBlock Text="{DynamicResource ph_Equipment}" Margin="0,0,0,5" Foreground="#666"/>
                    <Grid>
                        <TextBox x:Name="txtSearchEquip" Tag="E"
                                 materialDesign:HintAssist.Hint=""
                                 Text="{Binding SearchEquipmentText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <Popup IsOpen="{Binding IsDropDownOpenE}" PlacementTarget="{Binding ElementName=txtSearchEquip}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="2"
                                    Width="{Binding ElementName=txtSearchEquip, Path=ActualWidth}" MaxHeight="250">
                                <ListBox x:Name="lstEquip" DisplayMemberPath="Text" BorderThickness="0"
                                         ItemsSource="{Binding EquipmentSuggestions}" SelectedItem="{Binding SelectedEquipment}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <Button Content="{DynamicResource btn_Search}" Width="90" Height="35"
                        Margin="15,20,0,0" Command="{Binding SearchCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>

                <Button Content="{DynamicResource btn_Clear}" Width="100" Height="35"
                        Margin="10,20,0,0" Command="{Binding ClearCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,15,0,10" VerticalAlignment="Center">
                <DatePicker Width="130" SelectedDate="{Binding SelectedDateFrom}"
                            materialDesign:HintAssist.Hint="{DynamicResource ph_DateFrom}"/>

                <DatePicker Width="130" Margin="10,0,0,0" SelectedDate="{Binding SelectedDateTo}"
                            materialDesign:HintAssist.Hint="{DynamicResource ph_DateTo}"/>

                <TextBlock Text="{DynamicResource ph_MinPrice}" VerticalAlignment="Center" Margin="25,0,0,0" Foreground="#666"/>
                <xctk:DoubleUpDown Value="{Binding PriceMin, Mode=TwoWay}" Minimum="0" Width="100" Margin="10,0,0,0"/>

                <TextBlock Text="{DynamicResource ph_MaxPrice}" VerticalAlignment="Center" Margin="25,0,0,0" Foreground="#666"/>
                <xctk:DoubleUpDown Value="{Binding PriceMax, Mode=TwoWay}" Minimum="0" Width="100" Margin="10,0,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource lbl_TotalRecords}" FontSize="14"/>
                    <TextBlock Text="{Binding SelectedCount, StringFormat={}{0:N0}}" Margin="5,0,0,0" 
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding PurchaseDtos}" AutoGenerateColumns="False" 
                      IsReadOnly="True" ColumnHeaderHeight="40" materialDesign:DataGridAssist.CellPadding="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_Model}" Binding="{Binding ModelName}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_Vendor}" Binding="{Binding VendorName}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_Equipment}" Binding="{Binding EquipmentName}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_Quantity}" Binding="{Binding Quantity, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_UnitPrice}" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_TotalPrice}" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_Currency}" Binding="{Binding CurrencyName}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_PurchaseDate}" Binding="{Binding PurchaseDate, StringFormat=dd/MM/yyyy}"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_Note}" Width="*" Binding="{Binding Note}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="{DynamicResource btn_Prev}" Width="60" Height="30" 
                        Command="{Binding PrevCommand}" Style="{StaticResource MaterialDesignFlatButton}"/>
                <Border Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="15" Width="30" Height="30" Margin="10,0">
                    <TextBlock Text="{Binding CurrentPage}" Foreground="White" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                </Border>
                <Button Content="{DynamicResource btn_Next}" Width="60" Height="30" 
                        Command="{Binding NextCommand}" Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>