<Page x:Class="WpfApp2.view.analysis.EquipmentAnalysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.view.analysis"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="EquipmentAnalysis"
      TextOptions.TextFormattingMode="Display"
      RenderOptions.EdgeMode="Aliased"
      RenderOptions.BitmapScalingMode="LowQuality">

    <Page.Resources>
        <SolidColorBrush x:Key="MainNavy" Color="#162D46"/>
        <SolidColorBrush x:Key="SubBlue" Color="#254D76"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3A75B0"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="{StaticResource MainNavy}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"  CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MainNavy}">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Wrench" Foreground="White" Width="18" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource menu_Inquiry}" Foreground="White" FontSize="15" FontWeight="Medium"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="{DynamicResource ph_Equipment}" FontSize="10" Foreground="Gray"/>
                    <Grid>
                        <TextBox x:Name="txtGlobalSearch" Width="250" Height="30" VerticalContentAlignment="Center" Padding="5,0,25,0"
                         Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <fa:ImageAwesome Icon="Search" Foreground="#CCC" Width="12" HorizontalAlignment="Right" Margin="0,0,8,0" IsHitTestVisible="False"/>
                        <Popup IsOpen="{Binding IsSearchDropDownOpen}" PlacementTarget="{Binding ElementName=txtGlobalSearch}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Width="250" MaxHeight="300">
                                <ListBox x:Name="lstSearchResults" ItemsSource="{Binding SearchSuggestions}" SelectedItem="{Binding SelectedSearchResult}"
                                 DisplayMemberPath="Text" BorderThickness="0" PreviewMouseLeftButtonDown="OnListBoxItemClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource ph_DateFrom}" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                    <DatePicker Width="120" SelectedDate="{Binding FromDate}"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="{DynamicResource ph_DateTo}" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                    <DatePicker Width="120" SelectedDate="{Binding ToDate}"/>
                </StackPanel>

                <Button Content="{DynamicResource btn_Analyze}" VerticalAlignment="Bottom" Height="30" Margin="10,0,0,2"
                Command="{Binding AnalyzeCommand}" Background="{StaticResource AccentBlue}" Foreground="White" Padding="25,0" BorderThickness="0"/>

            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Margin="10,5">
            <Border Background="{StaticResource SubBlue}" CornerRadius="5" Margin="6" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Money" Foreground="#FFD700" Width="25"/>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="{DynamicResource lbl_TotalPurchaseValue}" Foreground="White" Opacity="0.8" FontSize="11"/>
                        <TextBlock Text="{Binding Analysis.TotalPrice, StringFormat={}{0:N0} VND}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SubBlue}" CornerRadius="5" Margin="6" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Cubes" Foreground="White" Width="25"/>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="{DynamicResource lbl_TotalParts}" Foreground="White" Opacity="0.8" FontSize="11"/>
                        <TextBlock Text="{Binding Analysis.TotalModel, StringFormat={}{0} Model}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SubBlue}" CornerRadius="5" Margin="6" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="InfoCircle" Foreground="#90EE90" Width="25"/>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="{DynamicResource ph_Equipment}" Foreground="White" Opacity="0.8" FontSize="11"/>
                        <TextBlock Text="{Binding Analysis.EquipmentName}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource lbl_VendorComparison}" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                    <lvc:PieChart Series="{Binding PieSeriesCollection}" LegendLocation="Right" InnerRadius="30" 
                                  DisableAnimations="True" Hoverable="False" DataTooltip="{x:Null}"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource lbl_PurchasedPartsList}" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                    <lvc:CartesianChart x:Name="ChartTopItems" DisableAnimations="True" Hoverable="False" DataTooltip="{x:Null}">
                        <lvc:CartesianChart.Series>
                            <lvc:RowSeries Values="{Binding TopItemsValues}" Fill="{StaticResource AccentBlue}" DataLabels="True"/>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Value" MinValue="0"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Labels="{Binding TopItemsLabels}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1" IsEnabled="False"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="5" Margin="18,10,18,10">
            <DataGrid ItemsSource="{Binding Analysis.Items}" SelectionMode="Single" ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource ph_ModelName}" Width="2*" Binding="{Binding ModelName}"/>
                    <DataGridTextColumn Header="{DynamicResource lbl_Brand}" Width="*" Binding="{Binding BrandName}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_Quantity}" Width="80" Binding="{Binding Quantity, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="{DynamicResource dg_TotalPrice}" Width="130" Binding="{Binding LineTotal, StringFormat={}{0:N0}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource SubBlue}"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource dg_PurchaseDate}" Width="100" Binding="{Binding PurchaseDate, StringFormat='dd/MM/yyyy'}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5" Background="{StaticResource MainNavy}" Padding="10,5">
            <UniformGrid Columns="4">
                <Button Style="{StaticResource FooterButtonStyle}" Command="{Binding NavModelAnalysis}">
                    <StackPanel>
                        <fa:ImageAwesome Icon="Cube" Foreground="White" Width="16" Margin="0,0,0,3"/>
                        <TextBlock Text="Model" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterButtonStyle}" Command="{Binding NavVendorAnalysis}">
                    <StackPanel>
                        <fa:ImageAwesome Icon="Industry" Foreground="White" Width="16" Margin="0,0,0,3"/>
                        <TextBlock Text="{DynamicResource ph_Vendor}" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterButtonStyle}" Command="{Binding NavBrandAnalysis}">
                    <StackPanel>
                        <fa:ImageAwesome Icon="Flash" Foreground="White" Width="16" Margin="0,0,0,3"/>
                        <TextBlock Text="{DynamicResource lbl_Brand}" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterButtonStyle}" Tag="Active">
                    <StackPanel>
                        <fa:ImageAwesome Icon="Wrench" Foreground="White" Width="16" Margin="0,0,0,3"/>
                        <TextBlock Text="{DynamicResource ph_Equipment}" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</Page>