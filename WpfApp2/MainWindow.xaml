<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="{DynamicResource lbl_PriceManagementSystem}" Height="750" Width="1200"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="#D5DBDB"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="45,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#455A64"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#2E4053"/>
                    <Setter Property="Foreground" Value="#1ABC9C"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderThickness" Value="5,0,0,0"/>
                    <Setter Property="BorderBrush" Value="#1ABC9C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MyExpanderStyle" TargetType="Expander" BasedOn="{StaticResource MaterialDesignExpander}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="180" MaxWidth="500"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#2C3E50" Padding="20,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="5" Padding="5" Margin="0,0,12,0">
                        <Image Source="/Images/logo.jpg" Width="30" Height="25" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource lbl_PriceManagementSystem}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Management &amp; Automation System" Foreground="#BDC3C7" FontSize="11" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding resetCurrencyCommand}" 
                            ToolTip="Refresh Data" 
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="#ECF0F1"
                            Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>

                    <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges" StaysOpen="False" Foreground="White">
                        <materialDesign:PopupBox.ToggleContent>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Translate" Width="24" Height="24" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </materialDesign:PopupBox.ToggleContent>
                        <StackPanel Width="160">
                            <Button Content="{DynamicResource lang_VN}" FontSize="14" Command="{Binding ChangeLangCommand}" CommandParameter="vi-VN"/>
                            <Button Content="{DynamicResource lang_EN}" FontSize="14" Command="{Binding ChangeLangCommand}" CommandParameter="en-US"/>
                            <Button Content="{DynamicResource lang_KR}" FontSize="14" Command="{Binding ChangeLangCommand}" CommandParameter="ko-KR"/>
                        </StackPanel>
                    </materialDesign:PopupBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#34495E" FocusManager.IsFocusScope="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,15,0,0">

                    <Expander Header="{DynamicResource menu_Inquiry}" Style="{StaticResource MyExpanderStyle}" IsExpanded="True">
                        <StackPanel Background="#2C3E50">
                            <Button Content="{DynamicResource sub_PurchaseAnalysis}" Command="{Binding ShowPurchaseAnalysisPageCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                            <Button Content="{DynamicResource sub_ModelAnalysis}" Command="{Binding ShowModelAnalysisCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                            <Button Content="{DynamicResource sub_VendorAnalysis}" Command="{Binding ShowVendorAnalysisCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                            <Button Content="{DynamicResource sub_BrandAnalysis}" Command="{Binding ShowBrandAnalysisCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                            <Button Content="{DynamicResource sub_EquipmentAnalysis}" Command="{Binding ShowEquipmentAnalysisCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{DynamicResource menu_DataManagement}" Style="{StaticResource MyExpanderStyle}">
                        <StackPanel Background="#2C3E50">
                            <Button Content="{DynamicResource sub_Model}" Command="{Binding ShowModelPageCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                            <Button Content="{DynamicResource sub_Brand}" Command="{Binding ShowBrandlPageCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                            <Button Content="{DynamicResource sub_Vendor}" Command="{Binding ShowVendorPageCommand}" Style="{StaticResource SidebarButtonStyle}" />
                            <Button Content="{DynamicResource sub_Equipment}" Command="{Binding ShowEquipmentPageCommand}" Style="{StaticResource SidebarButtonStyle}" />
                            <Button Content="{DynamicResource sub_PurchaseHistory}" Command="{Binding ShowPurchaseHistoryPageCommand}" Style="{StaticResource SidebarButtonStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="{DynamicResource menu_Excel}" Style="{StaticResource MyExpanderStyle}">
                        <StackPanel Background="#2C3E50">
                            <Button Content="{DynamicResource sub_ExcelUpload}" Command="{Binding ShowImportExcelCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{DynamicResource menu_Settings}" Style="{StaticResource MyExpanderStyle}">
                        <StackPanel Background="#2C3E50">
                            <Button Content="{DynamicResource sub_User}" Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowUserPageCommand}" Visibility="{Binding IsAdminVisible}" />
                            <Button Content="{DynamicResource btn_Logout}" Style="{StaticResource SidebarButtonStyle}" Command="{Binding LogoutCommand}" Foreground="#E74C3C" FontWeight="Bold"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1" 
                      Width="4" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                      Background="#212F3C"
                      ShowsPreview="True"/>

        <Grid Grid.Row="1" Grid.Column="2" Background="#F8F9F9">
            <Border Margin="20" Background="White" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="#D0D3D4"/>
                </Border.Effect>
                <Frame Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>

    </Grid>
</Window>